{
  "name": "norderstedt-roblox-monorepo",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:control-center": "pnpm --filter control-center run dev",
    "build:control-center": "pnpm --filter control-center run build",
    "roblox:build": "pnpm run roblox:build:versioned",
    "roblox:build:versioned": "node scripts/build-roblox-versioned.mjs",
    "geodata:build": "cd tools/geodata && python -m uv run python src/pipeline.py && python -m uv run python src/export_roblox.py",
    "lint:luau": "node scripts/lint-luau.mjs",
    "format:luau:check": "node scripts/lint-luau.mjs"
  }
}